    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "verify": "node verify/inject-check.mjs",
    "verify:cdp": "node verify/inject-check.mjs"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
